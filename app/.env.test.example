# Playwright E2E 로그인 필요 테스트용 로컬 자격 증명.
# 이 파일을 .env.test로 복사하고 실제 값을 채운 뒤 사용하세요.
# .env.test는 .gitignore에 등록되어 있어 커밋되지 않습니다 — 절대
# 이 값을 코드나 커밋 메시지에 직접 적지 마세요.

# frame-checker-worker에 등록된 DEV_LOGIN_SECRET 값.
# 확인/재등록: cd frame-checker-worker && npx wrangler secret put DEV_LOGIN_SECRET
# (값을 잊었다면 새로 생성해 put하면 됩니다 — 기존 값을 조회하는 방법은 없습니다)
E2E_DEV_LOGIN_SECRET=

# 참여자 명단(구글 시트)에 등록된 테스트 계정 이메일. 명단에 없는 이메일은
# /dev/login도 403으로 거부합니다(실제 로그인과 동일한 권한 검사).
E2E_TEST_EMAIL=
